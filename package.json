{
  "name": "react-native-windows-image-picker",
  "version": "0.1.0-pre.0",
  "description": "A native image and document picker TurboModule for React Native Windows (new architecture), backed by Windows.Storage.Pickers.FileOpenPicker.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "windows/RNWImagePicker/RNWImagePicker.vcxproj",
    "windows/RNWImagePicker/RNWImagePicker.vcxproj.filters",
    "windows/RNWImagePicker/RNWImagePicker.def",
    "windows/RNWImagePicker/PropertySheet.props",
    "windows/RNWImagePicker/*.idl",
    "windows/RNWImagePicker/*.h",
    "windows/RNWImagePicker/*.cpp",
    "windows/ExperimentalFeatures.props",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "react-native-windows",
    "windows",
    "image-picker",
    "document-picker",
    "file-picker",
    "turbomodule",
    "fabric",
    "winrt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FacilitronWorks/react-native-windows-image-picker.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "react-native": ">=0.76.0",
    "react-native-windows": ">=0.76.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "RNWImagePicker",
      "namespace": "RNWImagePicker",
      "template": "cpp-lib"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
